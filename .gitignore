# Dependencies
node_modules/
*/node_modules/
.venv/
*/.venv/
venv/
env/

# Python cache & test artifacts
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Database & runtime uploads
*.db
*.sqlite3
backend/storage/quotes/*.pdf
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
!backend/storage/quotes/.gitkeep

# Operating system files
.DS_Store
*.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# Large temporary archives & scratch scripts
cnc-tube-cpq-prototype.zip
scratch/
dist/

# Allow pre-compiled frontend distribution for 1-click standalone execution
!frontend/dist
!frontend/dist/**
